---
interface Props {
  title: string
  href?: string
}

const { title, href } = Astro.props
---

<section class='section'>
  <h2>{href ? <a href={href}>{title}</a> : title}</h2>
  <slot />
</section>

<style>
  .section {
    display: grid;
    grid-template-columns: minmax(9rem, 1fr) minmax(0, 3fr);
    gap: 0 2rem;
    padding: 2rem 0;
    border-top: 1px solid hsl(var(--border));
  }
  h2 {
    font: 400 clamp(1.7rem, 3vw, 2.1rem) / 1.12 Georgia, 'Times New Roman', serif;
    letter-spacing: -0.035em;
  }
  h2 a:hover { text-decoration: underline; text-underline-offset: 0.15em; }
  .section > :global(article) { grid-column: 2; }
  @media (max-width: 640px) {
    .section { display: block; padding: 1.65rem 0; }
    h2 { margin-bottom: 1rem; }
    h2:last-child { margin-bottom: 0; }
  }
</style>
