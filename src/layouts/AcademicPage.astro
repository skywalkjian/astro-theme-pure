---
import BaseLayout from '@/layouts/BaseLayout.astro'

interface Props {
  title: string
}

const { title } = Astro.props
---

<BaseLayout meta={{ title }}>
  <main class='academic-page' data-pagefind-body>
    <h1>{title}</h1>
    <slot />
  </main>
</BaseLayout>

<style>
  .academic-page {
    min-height: 60vh;
    padding-block: clamp(1.5rem, 4vw, 3.5rem);
  }

  h1 {
    margin: 0 0 clamp(1.75rem, 4vw, 3rem);
    padding-bottom: 1.25rem;
    border-bottom: 1px solid hsl(var(--border));
    font:
      400 clamp(2.75rem, 6vw, 4.6rem) / 1.1 Georgia,
      'Times New Roman',
      serif;
    letter-spacing: -0.045em;
  }
</style>
