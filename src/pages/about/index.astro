---
import AcademicPage from '@/layouts/AcademicPage.astro'

export const prerender = true
---

<AcademicPage title='About'>
  <div class='bio'>
    <p>
      I’m an undergraduate at Peking University studying artificial intelligence. I started out
      working on AI infrastructure and now focus on generative models and multimodal learning.
    </p>

    <section>
      <h2>Outside research</h2>
      <p>
        I enjoy reading about economics and political science, especially Marxist political economy.
        I also like football, Go, anime and comics. I’ve played Minecraft for years, and my favorite
        strategy games include Civilization and Stellaris.
      </p>
    </section>

    <section>
      <h2>Contact</h2>
      <ul class='contacts'>
        <li><a href='mailto:bjdx2385005155@stu.pku.edu.cn'>Email</a></li>
        <li><a href='https://github.com/skywalkjian'>GitHub</a></li>
        <li><a href='https://www.zhihu.com/people/chen-20-9-92'>Zhihu</a></li>
      </ul>
    </section>
  </div>
</AcademicPage>

<style>
  .bio {
    max-width: 65ch;
    font-size: 1.075rem;
    line-height: 1.7;
  }

  section {
    margin-top: 2rem;
  }

  h2 {
    margin-bottom: 0.65rem;
    font:
      400 1.65rem / 1.2 Georgia,
      'Times New Roman',
      serif;
  }

  p {
    color: hsl(var(--muted-foreground));
  }

  .contacts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }

  a {
    color: hsl(var(--primary));
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
