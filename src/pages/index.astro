---
import { Image } from 'astro:assets'
import { Icon } from 'astro-pure/user'
import avatar from '@/assets/avatar.png'
import pku from '@/assets/pku.png'
import Section from '@/components/home/Section.astro'
import PageLayout from '@/layouts/BaseLayout.astro'
import config from '@/site-config'
import { linkGroups } from '../data/links'

export const prerender = true

const experience = [
  {
    institution: 'RedNote Dots',
    role: 'Research Intern, Multimodal Team',
    dates: 'Apr 2026 – present',
    focus: 'Generative transformers and reward-guided post-training for image generation.'
  },
  {
    institution: 'The Chinese University of Hong Kong, Shenzhen',
    role: 'Research Assistant',
    dates: 'Jul – Sep 2026',
    focus: 'Architectures for continuous diffusion language models.'
  },
  {
    institution: 'Huawei',
    role: 'R&D Intern, MindSpore',
    dates: 'Nov 2025 – Jan 2026',
    focus: 'Operator fusion and scheduling for heterogeneous computing.'
  }
]
---

<PageLayout meta={{ title: 'Academic Homepage' }}>
  <main class='home' data-pagefind-body>
    <section class='profile' aria-labelledby='profile-name'>
      <div>
        <a class='affiliation' href='https://www.pku.edu.cn/'>
          <Image src={pku} alt='' width={29} height={29} />
          Peking University
        </a>
        <h1 id='profile-name'>{config.author}</h1>
        <p class='intro'>
          I’m an undergraduate studying artificial intelligence at Peking University.
          My research focuses on generative models and multimodal learning, particularly
          image generation and diffusion language models.
        </p>
        <div class='contacts'>
          <a href='mailto:yj_chen@stu.pku.edu.cn'><Icon name='email' />Email</a>
          <a href='https://github.com/skywalkjian'><Icon name='github' />GitHub</a>
          <a href='/cv/moderncv.pdf'><Icon name='document' />Curriculum vitae</a>
        </div>
      </div>
      <div class='portrait'>
        <Image src={avatar} alt='Hand-drawn profile avatar' widths={[212, 424]} sizes='(max-width: 640px) 112px, 200px' width={212} loading='eager' />
      </div>
    </section>

    <Section title='Education'>
      <article class='entry'>
        <div class='entry-heading'>
          <h3>Peking University</h3>
          <span class='dates'>Sep 2024 – present</span>
        </div>
        <p>B.S. in Artificial Intelligence, EECS</p>
      </article>
    </Section>

    <Section title='Experience'>
      {experience.map(({ institution, role, dates, focus }) => (
        <article class='entry'>
          <div class='entry-heading'>
            <h3>{institution}</h3>
            <span class='dates'>{dates}</span>
          </div>
          <p>{role}</p>
          <p class='focus'>{focus}</p>
        </article>
      ))}
    </Section>

    <Section title='Papers' href='/papers' />
    <Section title='Links' href='/links'>
      <ul class='directory-links'>
        {linkGroups.map(({ id, title }) => (
          <li><a href={`/links#${id}`}>{title}</a></li>
        ))}
      </ul>
    </Section>
  </main>
</PageLayout>

<style>
  .home { padding-bottom: 3rem; }
  .directory-links { display: flex; flex-wrap: wrap; gap: 0.6rem 1.5rem; align-items: baseline; }
  .directory-links a { color: hsl(var(--primary)); text-decoration: underline; text-underline-offset: 0.2em; }
  .profile {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(9rem, 13rem);
    gap: clamp(2rem, 7vw, 6.25rem);
    align-items: center;
    padding: clamp(3rem, 7vw, 5rem) 0;
  }
  .affiliation, .contacts, .contacts a { display: flex; align-items: center; }
  .affiliation {
    width: fit-content;
    gap: 0.6rem;
    font-size: 0.95rem;
    font-weight: 650;
    color: hsl(var(--primary));
  }
  h1 {
    margin: 0.85rem 0 1.1rem;
    font: 400 clamp(3.15rem, 6.8vw, 5.35rem) / 1 Georgia, 'Times New Roman', serif;
    letter-spacing: -0.055em;
  }
  .intro {
    max-width: 56ch;
    font-size: clamp(1.05rem, 1.6vw, 1.17rem);
    line-height: 1.65;
    color: hsl(var(--muted-foreground));
  }
  .contacts { margin-top: 1.35rem; gap: 0.45rem 1.4rem; flex-wrap: wrap; }
  .contacts a { gap: 0.38rem; padding-block: 0.25rem; font-size: 0.95rem; font-weight: 600; }
  .contacts :global(svg) { height: 1.1rem; width: 1.1rem; color: hsl(var(--primary)); }
  .portrait {
    padding: 0.4rem;
    border: 1px solid hsl(var(--border));
    background: hsl(var(--card));
  }
  .portrait img { width: 100%; height: auto; }
  .entry + .entry { margin-top: 1.6rem; }
  .entry-heading { display: flex; justify-content: space-between; align-items: baseline; gap: 0.15rem 0.75rem; flex-wrap: wrap; }
  h3 { font-weight: 650; font-size: 1.1rem; line-height: 1.4; }
  .dates { font-size: 0.875rem; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .dates, .focus { color: hsl(var(--muted-foreground)); }
  .entry p { margin-top: 0.2rem; line-height: 1.5; }
  .entry .focus { font-size: 0.95rem; }
  @media (max-width: 640px) {
    .profile { display: block; position: relative; padding-block: 2.5rem; }
    .affiliation, h1 { max-width: calc(100% - 6.8rem); }
    h1 { margin-bottom: 2rem; }
    .portrait { position: absolute; inset: 2.5rem 0 auto auto; width: clamp(4.65rem, 16vw, 6.6rem); padding: 0.2rem; }
  }
  @media (max-width: 380px) {
    h1 { font-size: 2.6rem; }
    .affiliation { font-size: 0.875rem; }
  }
</style>
