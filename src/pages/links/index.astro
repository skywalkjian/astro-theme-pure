---
import { linkGroups } from '../../data/links'
import AcademicPage from '@/layouts/AcademicPage.astro'

export const prerender = true
---

<AcademicPage title='Links'>
  <div class='directory'>
    {linkGroups.map(({ id, title, people }) => (
      <section aria-labelledby={id}>
        <h2 id={id}>{title}</h2>
        {people.length > 0 && (
          <ul>
            {people.map(({ name, link, intro }) => (
              <li>
                <a href={link}>{name}</a>
                <p>{intro}</p>
              </li>
            ))}
          </ul>
        )}
      </section>
    ))}
  </div>
</AcademicPage>

<style>
  .directory { padding-bottom: 1rem; }
  section {
    display: grid;
    grid-template-columns: minmax(10rem, 1fr) minmax(0, 3fr);
    gap: 1.2rem 2rem;
    padding-bottom: 2rem;
  }
  section + section { padding-top: 2rem; border-top: 1px solid hsl(var(--border)); }
  h2 {
    font: 400 clamp(1.6rem, 3vw, 2rem) / 1.15 Georgia, 'Times New Roman', serif;
    letter-spacing: -0.035em;
    scroll-margin-top: 1.5rem;
  }
  ul { display: grid; gap: 1.2rem; }
  a {
    color: hsl(var(--primary));
    font-weight: 650;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  p { margin-top: 0.2rem; line-height: 1.55; color: hsl(var(--muted-foreground)); }
  @media (max-width: 640px) {
    section { grid-template-columns: 1fr; }
  }
</style>
